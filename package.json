{
  "name": "stranded-detector",
  "version": "1.0.0",
  "private": true,
  "description": "A live Philippines heatmap for anonymous, short-lived stranded-person reports.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build:pages": "node scripts/build-pages.mjs",
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "test": "node --test --test-concurrency=1 tests/unit/*.test.js tests/integration/*.test.js",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e"
  },
  "dependencies": {
    "better-sqlite3": "^12.2.0",
    "cookie-parser": "^1.4.7",
    "ejs": "^6.0.1",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "htmx.org": "^2.0.6",
    "leaflet": "^1.9.4",
    "leaflet.heat": "^0.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.54.2",
    "supertest": "^7.1.4"
  }
}
