# Generate this with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
COOKIE_SECRET=replace-with-at-least-32-random-characters

# Generate a non-ephemeral auth key in the Tailscale admin console.
TS_AUTHKEY=hehe
TS_HOSTNAME=stranded-detector

# Override this to pin a tested Tailscale release if required.
TAILSCALE_IMAGE=tailscale/tailscale:latest

ENABLE_DEV_GPS=false
# GitHub Pages origin only, with no repository path (comma-separate additional origins).
FRONTEND_ORIGINS=https://YOUR-GITHUB-OWNER.github.io
REPORT_TTL_MS=300000
EXPIRY_SWEEP_MS=1000
HEARTBEAT_MS=15000
